#!/bin/sh
# Pi-hole scripts no longer use sudo/su to run as 'pihole' user
# This polyfill allows to use native setpriv binary when it is available
# and fallback to 'nonroot' when it is not

while [ "$#" -gt 0 ]; do
    case "$1" in
        --reuid=*)
            user=${1#--reuid=}
        ;;
        --regid=*)
            # ignored
        ;;
        --init-groups)
            # ignored
        ;;
        --)
            shift
            break
        ;;
        *)
            echo "Unsupported option: $1" >&2
            exit 1
        ;;
    esac
    shift
done

if [ -z "$user" ]; then
    echo "Missing --reuid option" >&2
    exit 1
fi

export USER="$user"

if [ -d "/opt/home/$user" ]; then
    export HOME="/opt/home/$user"
else
    export HOME=""
fi

exec nonroot "$user" "$@"
