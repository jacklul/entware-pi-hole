{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "label": "Clone Pi-hole repositories (release)",
            "type": "shell",
            "command": "bash scripts/dev.sh master",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Clone Pi-hole repositories (development)",
            "type": "shell",
            "command": "bash scripts/dev.sh development",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Create dev/core patch",
            "type": "shell",
            "command": "bash scripts/dev.sh diff core && code dev/patch_core.patch",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Create dev/FTL patch",
            "type": "shell",
            "command": "bash scripts/dev.sh diff ftl && code dev/patch_ftl.patch",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Create dev/web patch",
            "type": "shell",
            "command": "bash scripts/dev.sh diff web && code dev/patch_web.patch",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Patch dev/core",
            "type": "shell",
            "command": "bash scripts/dev.sh patch core",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Patch dev/FTL",
            "type": "shell",
            "command": "bash scripts/dev.sh patch ftl",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Patch dev/web",
            "type": "shell",
            "command": "bash scripts/dev.sh patch web",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Patch all repositories",
            "dependsOn": [
                "Patch dev/core",
                "Patch dev/FTL",
                "Patch dev/web"
            ]
        },
        {
            "label": "Reset dev/core",
            "type": "shell",
            "command": "bash scripts/dev.sh reset core",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Reset dev/FTL",
            "type": "shell",
            "command": "bash scripts/dev.sh reset ftl",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Reset dev/web",
            "type": "shell",
            "command": "bash scripts/dev.sh reset web",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Reset all repositories",
            "dependsOn": [
                "Reset dev/core",
                "Reset dev/FTL",
                "Reset dev/web"
            ]
        },
        {
            "label": "Test dev/core",
            "type": "shell",
            "command": "bash scripts/dev.sh test core",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Test dev/FTL",
            "type": "shell",
            "command": "bash scripts/dev.sh test ftl",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Test dev/web",
            "type": "shell",
            "command": "bash scripts/dev.sh test web",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Test all repositories",
            "dependsOn": [
                "Test dev/core",
                "Test dev/FTL",
                "Test dev/web"
            ]
        },
        {
            "label": "Repatch dev/core",
            "type": "shell",
            "command": "bash scripts/dev.sh repatch core",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Repatch dev/FTL",
            "type": "shell",
            "command": "bash scripts/dev.sh repatch ftl",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Repatch dev/web",
            "type": "shell",
            "command": "bash scripts/dev.sh repatch web",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Repatch all repositories",
            "dependsOn": [
                "Repatch dev/core",
                "Repatch dev/FTL",
                "Repatch dev/web"
            ]
        },
    ]
}
