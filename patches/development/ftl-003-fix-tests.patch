diff --git a/test/run.sh b/test/run.sh
index 5d490a82..dfd08dac 100755
--- a/test/run.sh
+++ b/test/run.sh
@@ -73,6 +73,23 @@ bash test/pdns/setup.sh
 OLDUMASK=$(umask)
 umask 0022
 
+# Symlink paths to not create patches for every single path...
+declare -A LINKS=(
+    ["/etc"]="/opt/etc"
+    ["/tmp"]="/opt/tmp"
+    ["/var/log"]="/opt/var/log"
+    ["/run"]="/opt/var/run"
+    ["/var/www/html"]="/opt/share/pihole/www"
+)
+for KEY in "${!LINKS[@]}"; do
+    DIRNAME="$(dirname "${LINKS[$KEY]}")"
+    [ ! -d "$DIRNAME" ] && mkdir -pv "$DIRNAME"
+
+    if [ -e "$KEY" ] && [ ! -L "${LINKS[$KEY]}" ]; then
+        ln -sv "$KEY" "${LINKS[$KEY]}"
+    fi
+done
+
 # Set exemplary config value by environment variable
 export FTLCONF_misc_nice="-11"
 export FTLCONF_dns_upstrrr="-11"
@@ -119,8 +119,8 @@ $BATS -p "test/test_suite.bats"
 fi
 
 curl_to_tricorder() {
-  curl --silent --upload-file "${1}" https://tricorder.pi-hole.net
+  echo "null"
 }
 
 if [[ $RET != 0 ]]; then
   echo -n "pihole/pihole.log: "
