diff --git a/test/run.sh b/test/run.sh
index 04ce54a5..b5f680f7 100755
--- a/test/run.sh
+++ b/test/run.sh
@@ -111,6 +111,24 @@ trap 'kill "${DOTDOH_SHIM_PID}" 2>/dev/null; pkill -f "${SHIM_PATTERN}" 2>/dev/n
 OLDUMASK=$(umask)
 umask 0022
 
+# Symlink paths to not create patches for every single path...
+declare -A LINKS=(
+    ["/etc"]="/opt/etc"
+    ["/tmp"]="/opt/tmp"
+    ["/var/log"]="/opt/var/log"
+    ["/run"]="/opt/var/run"
+    ["/var/www/html"]="/opt/share/pihole/www"
+    ["/usr/local/bin/pihole"]="/opt/bin/pihole"
+)
+for KEY in "${!LINKS[@]}"; do
+    DIRNAME="$(dirname "${LINKS[$KEY]}")"
+    [ ! -d "$DIRNAME" ] && mkdir -pv "$DIRNAME"
+
+    if [ -e "$KEY" ] && [ ! -L "${LINKS[$KEY]}" ]; then
+        ln -sv "$KEY" "${LINKS[$KEY]}"
+    fi
+done
+
 # Set exemplary config value by environment variable
 export FTLCONF_misc_nice="-11"
 export FTLCONF_dns_upstrrr="-11"
