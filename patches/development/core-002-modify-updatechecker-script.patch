 function get_remote_version() {
@@ -34,6 +59,14 @@ function get_remote_version() {
     fi
 }
 
+function get_remote_version_entware() {
+    if [[ "${1}" == "pi-hole" ]]; then
+        curl -s "https://api.github.com/repos/jacklul/entware-pi-hole/releases/latest" 2>/dev/null | jq --raw-output .tag_name || return 1
+    else
+        echo "null"
+    fi
+}
+
 function get_remote_hash() {
     git ls-remote "https://github.com/pi-hole/${1}" --tags "${2}" | awk '{print substr($0, 1,8);}' || echo "null"
 }
@@ -155,6 +155,21 @@ if [[ "${DOCKER_TAG}" ]]; then
     addOrEditKeyValPair "${VERSION_FILE_TMP}" "GITHUB_DOCKER_VERSION" "${GITHUB_DOCKER_VERSION}"
 fi
 
+if [ -f /opt/etc/opkg.conf ]; then
+    ENTWARE_PACKAGE="$(opkg list-installed pi-hole* | awk '{print $1}' | head -n 1)"
+    addOrEditKeyValPair "${VERSION_FILE_TMP}" "ENTWARE_PACKAGE" "${ENTWARE_PACKAGE}"
+
+    ENTWARE_VERSION="$(opkg list-installed "${ENTWARE_PACKAGE}" | awk '{print $3}')"
+    addOrEditKeyValPair "${VERSION_FILE_TMP}" "ENTWARE_VERSION" "${ENTWARE_VERSION}"
+
+    if [ "$ENTWARE_PACKAGE" = "pi-hole" ] && [[ ! "${ENTWARE_VERSION}" =~ $release_regex ]]; then
+        unset ENTWARE_PACKAGE
+    fi
+
+    GITHUB_ENTWARE_VERSION="$(get_remote_version_entware "$ENTWARE_PACKAGE")"
+    addOrEditKeyValPair "${VERSION_FILE_TMP}" "GITHUB_ENTWARE_VERSION" "${GITHUB_ENTWARE_VERSION}"
+fi
+
 # Make the assembled file world-readable ("other" needs read access so any local
 # user can run `pihole -v`).
 chmod 0644 "${VERSION_FILE_TMP}"
@@ -164,4 +164,5 @@ chmod 0644 "${VERSION_FILE_TMP}"
 # itself, so whatever was there before (even a symlink) is swapped out. -T
