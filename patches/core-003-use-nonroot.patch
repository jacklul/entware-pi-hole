-if [[ -z ${USER} ]]; then
-  USER=$(whoami)
-fi
+#if [[ -z ${USER} ]]; then
+#  USER=$(whoami)
+#fi
+
+# We cannot trust the USER variable when using nonroot
+USER=$(whoami)
 
 # Check if the current user is not root and if the command
 # requires root. If so, exit with an error message.
