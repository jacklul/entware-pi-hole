diff --git a/advanced/Templates/pihole-FTL-prestart.sh b/advanced/Templates/pihole-FTL-prestart.sh
index dda59c26..00c84e98 100755
--- a/advanced/Templates/pihole-FTL-prestart.sh
+++ b/advanced/Templates/pihole-FTL-prestart.sh
@@ -17,7 +17,7 @@ chown -R pihole:pihole /etc/pihole/ /var/log/pihole/
 # the pihole user do it: it owns everything below these directories, and a
 # symlink pointing anywhere else only results in a permission error.
 # A failure here is deliberately non-fatal so it can never prevent FTL starting.
-su -s /bin/sh pihole -c '
+nonroot pihole /bin/sh -c '
     find /opt/etc/pihole/ /opt/var/log/pihole/ -type d -exec chmod 0755 {} +
     find /opt/etc/pihole/ /opt/var/log/pihole/ -type f ! \( -name "*.pem" -o -name "*.crt" \) -exec chmod 0640 {} +
     find /opt/etc/pihole/ -type f \( -name "*.pem" -o -name "*.crt" \) -exec chmod 0600 {} +
@@ -37,7 +37,7 @@ su -s /bin/sh pihole -c '
 # commands simply fail with a permission error and the target is left untouched.
 # A failure here is deliberately non-fatal so it can never prevent FTL starting.
 # su is needed to change user; both files are handled in a single call.
-su -s /bin/sh pihole -c 'touch /opt/etc/pihole/versions /opt/etc/pihole/dhcp.leases && chmod 0644 /opt/etc/pihole/versions /opt/etc/pihole/dhcp.leases' || true
+nonroot pihole /bin/sh -c 'touch /opt/etc/pihole/versions /opt/etc/pihole/dhcp.leases && chmod 0644 /opt/etc/pihole/versions /opt/etc/pihole/dhcp.leases' || true
 
 # Touch files to ensure they exist (create if non-existing, preserve if existing)
 # Hardcoded PID path — see GHSA-6w8x-p785-6pm4
diff --git a/gravity.sh b/gravity.sh
index 1a78d8c2..78044941 100755
--- a/gravity.sh
+++ b/gravity.sh
@@ -17,7 +17,7 @@ export LC_ALL=C
 # Without a terminal on stdin, mv replaces leftover root-owned files instead of prompting
 if [[ "${EUID}" -eq 0 ]]; then
   chown pihole:pihole /opt/etc/pihole
-  exec sudo -u pihole bash "$0" "$@" </dev/null
+  exec nonroot pihole /bin/sh -c "$0 $*" </dev/null
 fi
 
 PI_HOLE_SCRIPT_DIR="/opt/share/pihole"
@@ -763,7 +763,7 @@ gravity_DownloadBlocklistFromUrl() {
         if [ "$(id -un)" == "root" ]; then
             # If we are root, we need to check if the pihole user has read permission
             #  otherwise, we might read files that the pihole user should not be able to read
-            if sudo -u pihole test -r "${file_path}"; then
+            if nonroot pihole test -r "${file_path}"; then
                 echo -e "${OVER}  ${INFO} Using local file ${file_path}"
             else
                 echo -e "${OVER}  ${CROSS} Cannot read file (user 'pihole' lacks read permission)"
@@ -827,7 +827,7 @@ gravity_DownloadBlocklistFromUrl() {
         if [ "$(id -un)" == "root" ]; then
           # The buffer belongs to the calling user, only the read must happen as pihole
           # shellcheck disable=SC2024
-          sudo -u pihole cat -- "${file_path}" >"${listCurlBuffer}"
+          nonroot pihole cat -- "${file_path}" >"${listCurlBuffer}"
         else
           cat -- "${file_path}" >"${listCurlBuffer}"
         fi
diff --git a/pihole b/pihole
index a0d0e1ef..ccde5478 100755
--- a/pihole
